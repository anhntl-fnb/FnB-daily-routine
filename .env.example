# Copy file này thành .env và điền thông tin thực
# Trong Routine: thêm vào "Environment variables" khi tạo routine

# ── Jira ──────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://citigo.atlassian.net
JIRA_EMAIL=your-email@citigo.vn
# Lấy tại: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# ── Google Chat Webhooks ───────────────────────────────────────────────
# Team 1 — Kho & Báo cáo (điền khi có)
GCHAT_WEBHOOK_TEAM1=

# Team 2 — Hàng hóa & F&B App (đã có)
GCHAT_WEBHOOK_TEAM2=https://chat.googleapis.com/v1/spaces/AAQArf8Shaw/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=cywPmZTzBIis4TSFkhRDrZ3LczK_rLV2AsPjR1LJRgg

